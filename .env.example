# Copy to .env and adjust. The agent is fully local by default.
MEETING_AGENT_CONFIG=config/default.yaml
MEETING_AGENT_DB=data/events.db

# Ollama (optional; only needed when vlm.provider=ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl

# Set to "1" to allow the automation layer to act (policy gate still applies)
MEETING_AGENT_ENABLE_AUTOMATION=0
